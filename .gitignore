# =============================================================================
# Syntaxe — fichiers exclus du dépôt.
# Principe : on versionne le SITE (pages, js, css, assets) et ses SOURCES
# (tools/content, tools/specs, les générateurs), pas les artefacts jetables ni
# ce qui se régénère d'une commande.
# =============================================================================

# Brouillons de travail : scripts d'analyse jetables, sauvegardes de chantier,
# sondes de mesure. Rien ici n'est nécessaire pour servir le site.
scratchpad/

# Captures d'écran de développement (136 PNG, 43 Mo). Elles ne servent ni au
# site ni à sa génération.
tools/shots/

# Journal de l'autonomie et état d'exécution : ils changent à chaque réveil et
# grossissent sans fin. Les SCRIPTS de .autonomie/, eux, sont versionnés.
.autonomie/journal.log
.autonomie/lock
.autonomie/verif-finale.ok
.autonomie/verif-finale.echecs

# Livrable régénérable depuis starter/
starter-kit.zip

# Divers systèmes
Thumbs.db
desktop.ini
.DS_Store
*.tmp
